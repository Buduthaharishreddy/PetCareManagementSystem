<%@ page import="java.util.*,com.petcare.model.Pet,com.petcare.model.MedicalRecord" %><%@ include file="partials/header.jspf" %>
<div class="page-heading"><div><div class="eyebrow">HEALTH HISTORY</div><h1>Medical records</h1><p class="muted">Review diagnosis and treatment information for your pets.</p></div></div>
<%if("ADMIN".equals(session.getAttribute("role"))||"STAFF".equals(session.getAttribute("role"))){List<Pet> pets=(List<Pet>)request.getAttribute("pets");%><section class="panel admin-panel"><h2>Add a medical record</h2><form method="post" action="<%=ctx%>/medical" class="form-grid"><label>Pet *<select name="petId" required><%for(Pet p:pets){%><option value="<%=p.getPetId()%>"><%=p.getPetName()%></option><%}%></select></label><label>Record date *<input type="date" name="recordDate" value="<%=java.time.LocalDate.now()%>" required></label><label>Diagnosis *<input name="diagnosis" required maxlength="500"></label><label>Treatment<input name="treatment" maxlength="1000"></label><label class="span-2">Notes<textarea name="notes" rows="2" maxlength="1000"></textarea></label><button class="btn btn-primary" type="submit">Save record</button></form></section><%}%>
<div class="panel"><div class="table-wrap"><table><thead><tr><th>Date</th><th>Pet</th><th>Diagnosis</th><th>Treatment</th><th>Notes</th></tr></thead><tbody><%List<MedicalRecord> records=(List<MedicalRecord>)request.getAttribute("records");if(records.isEmpty()){%><tr><td colspan="5" class="empty-state">No medical records found for your pets.</td></tr><%}else{for(MedicalRecord m:records){%><tr><td><%=m.getRecordDate()%></td><td><strong><%=m.getPetName()%></strong></td><td><%=m.getDiagnosis()%></td><td><%=m.getTreatment()==null?"":m.getTreatment()%></td><td><%=m.getNotes()==null?"":m.getNotes()%></td></tr><%}}%></tbody></table></div></div>
<%@ include file="partials/footer.jspf" %>
