<%@ page import="java.util.*,com.petcare.model.Pet,com.petcare.model.Vaccination" %><%@ include file="partials/header.jspf" %>
<div class="page-heading"><div><div class="eyebrow">PREVENTIVE CARE</div><h1>Vaccination history</h1><p class="muted">Keep vaccine dates and next due dates easy to find.</p></div></div>
<%if("ADMIN".equals(session.getAttribute("role"))||"STAFF".equals(session.getAttribute("role"))){List<Pet> pets=(List<Pet>)request.getAttribute("pets");%><section class="panel admin-panel"><h2>Record a vaccination</h2><form method="post" action="<%=ctx%>/vaccinations" class="form-grid"><label>Pet *<select name="petId" required><%for(Pet p:pets){%><option value="<%=p.getPetId()%>"><%=p.getPetName()%></option><%}%></select></label><label>Vaccine name *<input name="vaccineName" required maxlength="120"></label><label>Vaccination date *<input type="date" name="vaccinationDate" value="<%=java.time.LocalDate.now()%>" required></label><label>Next due date<input type="date" name="nextDueDate"></label><label class="span-2">Notes<textarea name="notes" rows="2" maxlength="500"></textarea></label><button class="btn btn-primary" type="submit">Save vaccination</button></form></section><%}%>
<div class="panel"><div class="table-wrap"><table><thead><tr><th>Pet</th><th>Vaccine</th><th>Vaccination date</th><th>Next due</th><th>Notes</th></tr></thead><tbody><%List<Vaccination> vs=(List<Vaccination>)request.getAttribute("vaccinations");if(vs.isEmpty()){%><tr><td colspan="5" class="empty-state">No vaccination history found.</td></tr><%}else{for(Vaccination v:vs){%><tr><td><strong><%=v.getPetName()%></strong></td><td><%=v.getVaccineName()%></td><td><%=v.getVaccinationDate()%></td><td><%=v.getNextDueDate()==null?"Not set":v.getNextDueDate()%></td><td><%=v.getNotes()==null?"":v.getNotes()%></td></tr><%}}%></tbody></table></div></div>
<%@ include file="partials/footer.jspf" %>
