<%@ page import="java.util.*,com.petcare.model.Pet,com.petcare.model.Service,com.petcare.model.Appointment" %><%@ include file="partials/header.jspf" %>
<div class="page-heading"><div><div class="eyebrow">VISITS & SCHEDULING</div><h1>Appointments</h1><p class="muted">Book a visit and keep track of its status.</p></div></div>
<div class="content-grid"><section class="panel"><h2>Book an appointment</h2><%List<Pet> pets=(List<Pet>)request.getAttribute("pets");List<Service> services=(List<Service>)request.getAttribute("services");%>
<%if(pets.isEmpty()){%><div class="note-box">Add a pet before booking an appointment. <a href="<%=ctx%>/pets">Add a pet →</a></div><%}else if(services.isEmpty()){%><div class="note-box">No active services are available right now.</div><%}else{%>
<form method="post" action="<%=ctx%>/appointments" class="form-stack"><label>Pet *<select name="petId" required><%for(Pet p:pets){%><option value="<%=p.getPetId()%>"><%=p.getPetName()%></option><%}%></select></label><label>Service *<select name="serviceId" required><%for(Service s:services){%><option value="<%=s.getServiceId()%>"><%=s.getServiceName()%> — ₹<%=s.getPrice()%></option><%}%></select></label><label>Date *<input type="date" name="appointmentDate" min="<%=java.time.LocalDate.now()%>" required></label><label>Time *<input type="time" name="appointmentTime" min="09:00" max="18:00" step="1800" required></label><label>Notes<textarea name="notes" rows="3" maxlength="500"></textarea></label><button class="btn btn-primary" type="submit">Book appointment</button></form><%}%></section>
<section class="panel panel-wide"><h2>Appointment history</h2><div class="table-wrap"><table><thead><tr><th>Pet / service</th><th>Date & time</th><th>Status</th><th>Action</th></tr></thead><tbody>
<%List<Appointment> aList=(List<Appointment>)request.getAttribute("appointments");if(aList.isEmpty()){%><tr><td colspan="4" class="empty-state">No appointments yet.</td></tr><%}else{for(Appointment a:aList){%><tr><td><strong><%=a.getPetName()%></strong><div class="subtext"><%=a.getServiceName()%></div></td><td><%=a.getAppointmentDate()%><div class="subtext"><%=a.getAppointmentTime()%></div></td><td><span class="status <%=a.getStatus().toLowerCase()%>"><%=a.getStatus()%></span></td><td><%if("BOOKED".equals(a.getStatus())){%><form method="post" action="<%=ctx%>/appointments" onsubmit="return confirm('Cancel this appointment?')"><input type="hidden" name="action" value="cancel"><input type="hidden" name="id" value="<%=a.getAppointmentId()%>"><button class="btn btn-small btn-danger" type="submit">Cancel</button></form><%}else{%>—<%}%></td></tr><%}}%>
</tbody></table></div></section></div>
<%@ include file="partials/footer.jspf" %>
