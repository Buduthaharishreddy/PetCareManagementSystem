<%@ page import="java.util.*,com.petcare.model.Service" %><%@ include file="partials/header.jspf" %>
<div class="page-heading"><div><div class="eyebrow">CARE OPTIONS</div><h1>Veterinary services</h1><p class="muted">Browse the services available for your pets.</p></div></div>
<% if("ADMIN".equals(session.getAttribute("role"))){ %><section class="panel admin-panel"><h2>Manage a service</h2><form method="post" action="<%=ctx%>/services" class="form-grid"><input type="hidden" name="serviceId" value="0"><label>Service name<input name="serviceName" required maxlength="100"></label><label>Price (₹)<input name="price" type="number" min="0" step="0.01" required></label><label class="span-2">Description<input name="description" maxlength="500"></label><label class="check-label"><input type="checkbox" name="active" value="1" checked> Active</label><button class="btn btn-primary" type="submit">Add service</button></form></section><% } %>
<div class="service-grid"><%List<Service> services=(List<Service>)request.getAttribute("services");if(services.isEmpty()){%><div class="panel empty-state">No services are currently available.</div><%}for(Service s:services){%><article class="service-card"><div class="service-symbol">✚</div><%if(!s.isActive()){%><span class="status cancelled">INACTIVE</span><%}%><h2><%=s.getServiceName()%></h2><p><%=s.getDescription()==null?"":s.getDescription()%></p><div class="service-bottom"><strong>₹ <%=s.getPrice()%></strong><a class="text-link" href="<%=ctx%>/appointments">Book →</a></div><%if("ADMIN".equals(session.getAttribute("role"))){%><details class="service-edit"><summary>Edit service</summary><form method="post" action="<%=ctx%>/services" class="form-stack"><input type="hidden" name="serviceId" value="<%=s.getServiceId()%>"><label>Name<input name="serviceName" value="<%=s.getServiceName()%>" required maxlength="100"></label><label>Price (₹)<input name="price" type="number" min="0" step="0.01" value="<%=s.getPrice()%>" required></label><label>Description<input name="description" value="<%=s.getDescription()==null?"":s.getDescription()%>" maxlength="500"></label><label class="check-label"><input type="checkbox" name="active" value="1" <%=s.isActive()?"checked":""%>> Active</label><button class="btn btn-small btn-primary" type="submit">Save changes</button></form></details><form method="post" action="<%=ctx%>/services" onsubmit="return confirm('Delete this service?')" class="inline-form"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="<%=s.getServiceId()%>"><button class="btn btn-small btn-danger" type="submit">Delete</button></form><%}%></article><%}%></div>
<%@ include file="partials/footer.jspf" %>
